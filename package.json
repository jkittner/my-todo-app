{
  "name": "todo-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A local-only kanban todo board that runs entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshots": "npm run build && node e2e/screenshots.mjs",
    "sample": "node scripts/make-sample.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "ical.js": "^2.2.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  }
}
